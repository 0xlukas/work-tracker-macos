    "'%@' has %lld time entries. Delete or reassign them first, or archive the project.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» hat %#@entries@. Löschen oder verschieben Sie diese zuerst oder archivieren Sie das Projekt."
          },
          "substitutions": {
            "entries": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Zeiteintrag"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Zeiteinträge"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%1$@' has %#@entries@. Delete or reassign them first, or archive the project."
          },
          "substitutions": {
            "entries": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg time entry"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg time entries"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "'%@' will be removed. You can undo this with ⌘Z.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» wird entfernt. Mit ⌘Z können Sie das rückgängig machen."
