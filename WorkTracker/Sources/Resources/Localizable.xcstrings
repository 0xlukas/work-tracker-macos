            "value": "Ferien"
          }
        }
      }
    },
    "Vacation beyond a year's allowance gets no time credit — those days count as normal working days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferien über dem Jahresguthaben werden nicht gutgeschrieben – diese Tage zählen als normale Arbeitstage."
          }
        }
      }
    },
    "Vacation days used this year (Jan–Dec). Half-day holidays count as 0.5 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Jahr (Jan–Dez) genutzte Ferientage. Halbtags-Feiertage zählen als 0,5 Tage."
          }
        }
      }
    },
    "Vacation days used this year, of %@ entitlement plus %@ carried over. Half-day holidays count as 0.5 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Jahr bezogene Ferientage, von %@ Anspruch plus %@ Übertrag. Halbe Feiertage zählen als 0.5 Tage."
          }
        }
      }
    },
