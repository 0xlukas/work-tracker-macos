    "Work Tracker %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker %@"
          }
        }
      }
    },
    "Work Tracker can’t open its database": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker kann seine Datenbank nicht öffnen"
          }
        }
      }
    },
    "Work Tracker can’t open its database.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker kann seine Datenbank nicht öffnen."
          }
        }
      }
    },
    "Work Tracker couldn’t back up this Mac’s data, so it didn’t delete anything. It tries again at the next sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker konnte die Daten dieses Macs nicht sichern und hat darum nichts gelöscht. Bei der nächsten Synchronisierung versucht es Work Tracker erneut."
          }
        }
      }
    },
    "Work Tracker isn’t allowed to use iCloud Drive. Allow it in System Settings ▸ Privacy & Security ▸ Files & Folders, then sync again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker darf iCloud Drive nicht verwenden. Erlauben Sie es in den Systemeinstellungen ▸ Datenschutz & Sicherheit ▸ Dateien & Ordner und synchronisieren Sie dann erneut."
          }
        }
      }
    },
    "Work Tracker isn’t allowed to use your calendars. Allow it in System Settings ▸ Privacy & Security ▸ Calendars.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker hat keinen Zugriff auf Ihre Kalender. Erlauben Sie ihn unter Systemeinstellungen ▸ Datenschutz & Sicherheit ▸ Kalender."
          }
        }
      }
    },
    "Work Tracker moves the current database into the Backups folder, restarts with an empty one and fills it with the data from sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker verschiebt die aktuelle Datenbank in den Backup-Ordner, startet mit einer leeren neu und füllt sie mit den synchronisierten Daten."
          }
        }
      }
    },
    "Work Tracker needs microphone access. Allow it in System Settings ▸ Privacy & Security ▸ Microphone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker braucht Zugriff auf das Mikrofon. Erlauben Sie ihn unter Systemeinstellungen ▸ Datenschutz & Sicherheit ▸ Mikrofon."
          }
        }
      }
    },
    "Work Tracker restarts and replaces the current data with the backup from %@. The current database is kept in the Backups folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker startet neu und ersetzt die aktuellen Daten durch das Backup vom %@. Die aktuelle Datenbank bleibt im Backup-Ordner erhalten."
          }
        }
      }
    },
    "Work Tracker restarts to use the new location. Changes are only saved there after the restart.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Work Tracker startet neu, um den neuen Speicherort zu verwenden. Änderungen werden erst nach dem Neustart dort gespeichert."
