    "Also copy each backup to another folder — for example a cloud drive — so your data survives losing this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Backup zusätzlich in einen anderen Ordner kopieren – etwa in einen Cloud-Speicher –, damit Ihre Daten auch einen Verlust dieses Macs überstehen."
          }
        }
      }
    },
    "An entry can’t cross midnight — split it into two entries.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Eintrag darf nicht über Mitternacht gehen — teilen Sie ihn in zwei Einträge auf."
          }
        }
      }
    },
    "Annual vacation entitlement": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jährlicher Ferienanspruch"
          }
